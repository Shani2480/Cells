{
  "name": "cells",
  "private": true,
  "version": "0.7.0",
  "author": "The Cells authors",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p packages/core && tsc -p packages/ooxml && tsc -p packages/io && tsc -p packages/chart && tsc -p packages/platform && tsc -p app",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run --project core --project app",
    "bench": "vitest run --project bench",
    "lint": "eslint . && prettier --check . && node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@cells/chart": "*",
    "@cells/core": "*",
    "@cells/io": "*",
    "@cells/ooxml": "*",
    "@cells/platform": "*",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "lucide-react": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
