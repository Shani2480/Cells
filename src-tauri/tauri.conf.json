{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cells",
  "mainBinaryName": "cells",
  "version": "0.6.0",
  "identifier": "app.cells.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Book1 - Cells",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "zoomHotkeysEnabled": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost"],
        "img-src": ["'self'", "blob:", "data:"],
        "font-src": ["'self'", "data:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "worker-src": ["'self'", "blob:"],
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1430",
        "connect-src": ["ipc:", "http://ipc.localhost", "ws://localhost:1430", "http://localhost:1430"],
        "img-src": ["'self'", "blob:", "data:"],
        "font-src": ["'self'", "data:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "script-src": ["'self'", "'unsafe-eval'", "http://localhost:1430"],
        "worker-src": ["'self'", "blob:"],
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "Local spreadsheet",
    "longDescription": "A local-only spreadsheet with Excel's interface, keyboard and formula behaviour.",
    "publisher": "Cells",
    "copyright": "Copyright (c) 2026 The Cells authors",
    "licenseFile": "../LICENSE",
    "license": "MIT",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["xlsx"],
        "name": "Workbook",
        "description": "Workbook",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "rank": "Default"
      },
      {
        "ext": ["xlsm"],
        "name": "Macro-Enabled Workbook",
        "description": "Macro-Enabled Workbook",
        "role": "Editor",
        "mimeType": "application/vnd.ms-excel.sheet.macroEnabled.12",
        "rank": "Default"
      },
      {
        "ext": ["xltx"],
        "name": "Workbook Template",
        "description": "Workbook Template",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.template",
        "rank": "Default"
      },
      {
        "ext": ["xltm"],
        "name": "Macro-Enabled Workbook Template",
        "description": "Macro-Enabled Workbook Template",
        "role": "Editor",
        "mimeType": "application/vnd.ms-excel.template.macroEnabled.12",
        "rank": "Default"
      },
      {
        "ext": ["csv"],
        "name": "CSV File",
        "description": "Comma-separated values",
        "role": "Editor",
        "mimeType": "text/csv",
        "rank": "Alternate"
      },
      {
        "ext": ["tsv"],
        "name": "Tab-Separated Values",
        "description": "Tab-separated values",
        "role": "Editor",
        "mimeType": "text/tab-separated-values",
        "rank": "Alternate"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "office",
        "desktopTemplate": "cells.desktop"
      },
      "rpm": {
        "desktopTemplate": "cells.desktop"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["cells"]
      }
    }
  }
}
